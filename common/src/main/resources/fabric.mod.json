{
	"schemaVersion": 1,
	"id": "biomesmod",
	"version": "${version}",
	"name": "Biomes Mod",
	"description": "Adds new Overworld, Nether and End biomes inspired by real places.",
	"authors": [
		"menonng"
	],
	"contact": {
		"sources": "https://github.com/menonng/biomesmod"
	},
	"license": "ARR",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.menonng.biomesmod.BiomesMod"
		],
		"terrablender": [
			"io.github.menonng.biomesmod.worldgen.TerraBlenderEntry"
		]
	},
	"mixins": [
		"biomesmod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=${fabric_kotlin_version}",
		"terrablender": "*"
	}
}
